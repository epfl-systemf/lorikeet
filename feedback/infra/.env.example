# Use absolute paths in production.
FEEDBACK_DATA_DIR=/srv/lorikeet-feedback
FEEDBACK_UID=1000
FEEDBACK_GID=1000

# Bind directly for a trusted local network or an existing reverse proxy.
FEEDBACK_BIND_ADDRESS=127.0.0.1
FEEDBACK_PORT=4173

# Required only when starting the optional `tls` profile.
FEEDBACK_HOSTNAME=feedback.example.edu
