[Unit]
Description=Code quality feedback
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=code-quality-feedback
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/java -jar /opt/code-quality-feedback/feedback-server.jar
Environment=FEEDBACK_PUBLIC_DIR=/srv/code-quality-feedback/public
Environment=FEEDBACK_DB=/var/lib/code-quality-feedback/feedback.sqlite
Environment=FEEDBACK_HOST=127.0.0.1
Environment=FEEDBACK_PORT=8766
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/srv/code-quality-feedback

[Install]
WantedBy=multi-user.target
